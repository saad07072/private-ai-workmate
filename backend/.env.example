NEBIUS_API_KEY=
GITHUB_TOKEN=

NEBIUS_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_REASONING_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

WORKMATE_TOOL_MODE=read_only
WORKMATE_COOKIE_SECURE=false

# Runtime storage. Docker Compose overrides these to mounted container paths.
WORKMATE_DATA_DIR=data
WORKMATE_DATABASE_PATH=data/workmate.db
WORKMATE_QDRANT_PATH=data/qdrant
WORKMATE_DOCUMENTS_PATH=data/documents
WORKMATE_AUDIT_FILE=data/tool_audit.jsonl

# Comma-separated browser origins allowed to call the backend directly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173